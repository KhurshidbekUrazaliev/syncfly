# Use an absolute directory ON YOUR DOCKER HOST (not inside the container).
RELAY_HOST_DATA_DIR=/opt/syncfly/data
# Must exactly match the browser's origin. Use HTTPS behind a reverse proxy.
RELAY_PUBLIC_URL=https://syncfly.example.com
# First user can register regardless; enable only for a trusted team.
RELAY_ALLOW_SIGNUP=false

# Required by compose.production.yaml; generate a private invite code with scripts/configure-cloud.py.
SYNCFLY_DOMAIN=syncfly.example.com
RELAY_INVITE_CODE=
